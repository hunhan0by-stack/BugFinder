# Basic scanner timeouts
SCAN_PAGE_TIMEOUT_MS=30000
SCAN_TOTAL_TIMEOUT_MS=90000
SCAN_SCREENSHOT_TIMEOUT_MS=15000

# Resource limits
SCAN_MAX_REDIRECTS=5
SCAN_MAX_REQUESTS=800
SCAN_MAX_UNIQUE_HOSTS=40
SCAN_MAX_BLOCKED_REQUEST_RECORDS=20
SCAN_MAX_CONCURRENT_SCANS=1

# Only these target ports are allowed by default.
SCAN_ALLOWED_PORTS=80,443

# Screenshot controls
SCAN_MAX_FULL_PAGE_HEIGHT=20000

# Phase 5 diagnostic collection
SCAN_DIAGNOSTIC_SETTLE_MS=1000
SCAN_MAX_DIAGNOSTIC_EVENTS=500
SCAN_MAX_DIAGNOSTIC_ISSUES=100
SCAN_MAX_CONSOLE_MESSAGE_LENGTH=2000
SCAN_MAX_PAGE_ERROR_MESSAGE_LENGTH=2000
SCAN_MAX_STACK_LENGTH=8000
SCAN_MAX_EVIDENCE_LENGTH=4000
SCAN_MAX_DIAGNOSTIC_URL_LENGTH=1000

# Phase 6 broken-image analysis
SCAN_BROKEN_IMAGE_TIMEOUT_MS=5000
SCAN_MAX_IMAGE_ELEMENTS=2000
SCAN_MAX_IMAGE_NETWORK_OUTCOMES=2000
SCAN_MAX_BROKEN_IMAGE_ISSUES=100
SCAN_MAX_IMAGE_SELECTOR_SAMPLES=3

# Phase 6 mobile layout
SCAN_MOBILE_VIEWPORT_WIDTH=390
SCAN_MOBILE_VIEWPORT_HEIGHT=844
SCAN_MOBILE_DEVICE_SCALE_FACTOR=1
SCAN_MOBILE_ANALYSIS_TIMEOUT_MS=10000
SCAN_MAX_LAYOUT_ELEMENTS=5000
SCAN_MAX_MOBILE_LAYOUT_ISSUES=50
SCAN_LAYOUT_OVERFLOW_TOLERANCE_PX=3
SCAN_MAX_LAYOUT_SELECTOR_LENGTH=500

# Phase 6 accessibility
SCAN_ACCESSIBILITY_TIMEOUT_MS=15000
SCAN_MAX_ACCESSIBILITY_ISSUES=100
SCAN_MAX_AXE_NODES_PER_RULE=5
SCAN_MAX_AXE_TARGET_LENGTH=500
SCAN_MAX_AXE_FAILURE_SUMMARY_LENGTH=2000

# Phase 7 safe interactions
SCAN_INTERACTION_DISCOVERY_TIMEOUT_MS=5000
SCAN_INTERACTION_CONTEXT_TIMEOUT_MS=12000
SCAN_INTERACTION_SETTLE_MS=1000
SCAN_INTERACTION_PRECLICK_QUIET_MS=250
SCAN_MAX_INTERACTION_CANDIDATES=100
SCAN_MAX_SAFE_CLICKS=5
SCAN_MAX_INTERACTION_ISSUES=50
SCAN_MAX_INTERACTION_SELECTOR_LENGTH=500
SCAN_MAX_INTERACTION_MUTATIONS=1000
SCAN_MAX_INTERACTION_CONTROLLED_TARGETS=20
SCAN_INTERACTION_OBSTRUCTION_TOLERANCE_PX=2
SCAN_INTERACTION_MIN_VISIBLE_AREA_PX=16

# Phase 8 issue evidence
SCAN_MAX_EVIDENCE_ARTIFACTS=12
SCAN_MAX_EVIDENCE_BYTES=8000000
SCAN_MAX_EVIDENCE_PER_ISSUE=3
SCAN_EVIDENCE_CONTEXT_PADDING_PX=48
SCAN_EVIDENCE_MIN_WIDTH_PX=64
SCAN_EVIDENCE_MIN_HEIGHT_PX=48
SCAN_EVIDENCE_MAX_WIDTH_PX=1000
SCAN_EVIDENCE_MAX_HEIGHT_PX=800
SCAN_EVIDENCE_SCREENSHOT_TIMEOUT_MS=4000

# Phase 8 reversible workflows
SCAN_MAX_REVERSIBLE_WORKFLOWS=3
SCAN_WORKFLOW_SETTLE_MS=1000
SCAN_WORKFLOW_CONTEXT_TIMEOUT_MS=15000
SCAN_WORKFLOW_STATE_COMPARE_TOLERANCE_PX=2
SCAN_MAX_WORKFLOW_MUTATIONS=1500
SCAN_MAX_WORKFLOW_ISSUES=30
SCAN_MAX_TOTAL_ACTUAL_CLICKS=12

# Local fixture access is disabled by default.
# Never enable ALLOW_LOCAL_FIXTURE in production.
ALLOW_LOCAL_FIXTURE=false

# Used only for local development and automated scanner tests.
LOCAL_FIXTURE_HOST=127.0.0.1
LOCAL_FIXTURE_PORT=3100
