# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.tmp/

# local audit scratch output
.tmp-export.json
.tmp-*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log
*.log
!package-lock.json

# local logs
/logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated scan screenshots and reports
/public/scan-results/*
!/public/scan-results/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
